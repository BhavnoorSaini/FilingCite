# Copy to .env and fill in. Backend scripts load it with: uv run --env-file ../.env ...
# On Vercel, the backend needs DATABASE_URL, the LLM_* and EMBEDDING_MODEL* settings,
# RETRIEVAL_TOP_K, PAGE_TABLES_MAX, CONTEXT_TOKEN_BUDGET, MIN_SIMILARITY and CALC_DECIMALS
# (the rest are for ingestion only).

# Neon Postgres. Locally use the direct connection (host without "-pooler");
# on Vercel use the pooled one (host with "-pooler"), which suits serverless functions.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Embedding size; must match the embedding model (bge-small-en-v1.5 = 384).
EMBEDDING_DIM=384

# Embedding model, loaded from a folder bundled with the backend (path relative to backend/).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_DIR=models/bge-small-en-v1.5
# Chunks embedded per batch during ingestion; 1 is fastest on CPU (no padding).
EMBEDDING_BATCH_SIZE=1

# Ingestion (Mac only). Paths are relative to backend/ or absolute.
CHUNK_WORDS=300
FINANCEBENCH_DIR=/path/to/financebench
PARSED_DIR=../data/parsed

# Answer-writing model (any OpenAI-compatible API; must support strict structured outputs).
# Provider-specific options go in LLM_EXTRA_BODY as JSON.
LLM_API_KEY=your-api-key
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_COMPLETION_TOKENS=4096
# Groq:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_EXTRA_BODY='{"reasoning_effort": "medium", "include_reasoning": false}'
# OpenRouter (routed to Groq's servers, only to providers supporting strict structured outputs):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_EXTRA_BODY='{"reasoning": {"effort": "medium", "exclude": true}, "provider": {"order": ["groq"], "require_parameters": true}}'

# Retrieval: chunks sent to the model, and the weakest best-match similarity still answered.
RETRIEVAL_TOP_K=10
MIN_SIMILARITY=0.62
# How many extra tables from the top chunks' pages to add.
PAGE_TABLES_MAX=2
# Most excerpt text (est. tokens) sent per question; Groq's free tier allows 8K tokens a minute.
CONTEXT_TOKEN_BUDGET=3500

# Decimal places for calculated ratios and percentages.
CALC_DECIMALS=2
