# Copy to .env and fill in. Backend scripts read it with: uv run --env-file ../.env ...
# Vercel needs everything except the ingestion settings.

# Neon Postgres: the direct connection locally, the pooled one ("-pooler") on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Embedding model, bundled with the backend. EMBEDDING_DIM must match it.
EMBEDDING_DIM=384
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_DIR=models/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=1

# Ingestion (Mac only). Paths are relative to backend/ or absolute.
CHUNK_WORDS=300
FINANCEBENCH_DIR=/path/to/financebench
PARSED_DIR=../data/parsed

# Answer-writing model on Groq.
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_COMPLETION_TOKENS=4096
LLM_EXTRA_BODY='{"reasoning_effort": "medium", "include_reasoning": false}'

# Chunks sent to the model, and the weakest best match that still gets an answer.
RETRIEVAL_TOP_K=10
MIN_SIMILARITY=0.62
# Most excerpt tokens per question; Groq's free tier allows 8K tokens a minute.
CONTEXT_TOKEN_BUDGET=3500

# Decimal places for results, unless the question asks for a rounding.
CALC_DECIMALS=2
